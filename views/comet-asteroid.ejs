<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Embedding a Partial file -->
    <%- include("./partials/head.ejs")%>
</head>

<body>
    <h1 class="bg-info text-white p-3 m-0"> <%=comet %> </h1>

    <!-- Embedding Nav --> 
    <%- include("./partials/nav.ejs") %>

    <div class="container-fluid row">

        <div class="card p-4 col">
            <h2> <%=comet %> </h2>
            
            <b>Description:</b>
            <%=cometInfo.def %>

            <b>Website Link:</b>
            <a href="<%=cometInfo.link %>"><%=comet %> Website Link</a>
        </div>

        <div class="card p-4 col">
            <img src="<%=cometInfo.image %>">
        </div>

    </div>
        
    <%- include("./partials/footer.ejs") %>

</body>

</html>