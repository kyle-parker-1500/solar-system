<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Embedding a Partial file -->
    <%- include("./partials/head.ejs")%>
</head>

<body>
    <h1 class="bg-info text-white p-3 m-0"> <%=planet %> </h1>

    <!-- Embedding Nav --> 
    <%- include("./partials/nav.ejs") %>

    <div class="container-fluid row">

        <div class="card p-4 col">
            <h2> <%=planet %> </h2>

            <b>Description:</b> 
            <%=planetInfo.description %>
            
            <b>Distance from Sun:</b>
            <%=planetInfo.distanceFromSun%>

            <b>  Year Length</b>
            <%= planetInfo.yearLength%>
                
            <b>Radius:</b>
            <%= planetInfo.radius %>

            <b> Earth Days:</b>
            <%= planetInfo.oneEarthDay%> 
                
            <b>Moons:</b>
            <%= planetInfo.moons %>

            <b>Website Link:</b>
            <a href="<%= planetInfo.websiteLink %>"><%= planet %> Link</a>
        </div>

        <div class="card p-4 col">
            <img src="<%= planetInfo.image %>">
        </div>

    </div>
        
    <%- include("./partials/footer.ejs") %>

</body>

</html>